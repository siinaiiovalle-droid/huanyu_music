        "lines": [
          {
            "time": 10.43,
            "zh": "清晨的风吹过窗台",
            "en": "Morning breeze slips across the windowsill",
            "chars": "10.43|清 11.09|晨 11.74|的 12.39|风 13.04|吹 13.7|过 14.35|窗 15|台"
          },
          {
            "time": 15.65,
            "zh": "第一缕光照亮未来",
            "en": "The first light brightens all that is to come",
            "chars": "15.65|第 16.3|一 16.96|缕 17.61|光 18.26|照 18.91|亮 19.57|未 20.22|来"
          },
          {
            "time": 20.87,
            "zh": "心跳在远处轻轻回响",
            "en": "A heartbeat echoes softly, far away",
            "chars": "20.87|心 21.52|跳 22.17|在 22.83|远 23.48|处 24.13|轻 24.46|轻 24.78|回 25.43|响"
          },
          {
            "time": 26.09,
            "zh": "像海浪拍打胸怀",
            "en": "Like ocean waves beating against the heart",
            "chars": "26.09|像 26.74|海 27.39|浪 28.04|拍 28.7|打 29.35|胸 30|怀"
          },
          {
            "time": 31.3,
            "zh": "越过山海",
            "en": "Over the mountains, over the seas",
            "chars": "31.3|越 31.96|过 32.61|山 33.26|海"
          },
          {
            "time": 33.91,
            "zh": "越过星辰",
            "en": "On beyond the stars",
            "chars": "33.91|越 34.57|过 35.22|星 35.87|辰"
          },
          {
            "time": 36.52,
            "zh": "所有距离",
            "en": "Every distance between us",
            "chars": "36.52|所 37.17|有 37.83|距 38.48|离"
          },
          {
            "time": 39.13,
            "zh": "都不算远",
            "en": "Is never too far",
            "chars": "39.13|都 39.78|不 40.43|算 41.09|远"
          },
          {
            "time": 41.74,
            "zh": "同一个世界同节拍",
            "en": "One world, one single beat",
            "chars": "41.74|同 42.39|一 43.04|个 43.7|世 44.35|界 45|同 45.65|节 46.3|拍"
          },
          {
            "time": 46.96,
            "zh": "不同语言同样的爱",
            "en": "Different tongues, the same love",
            "chars": "46.96|不 47.61|同 48.26|语 48.91|言 49.57|同 50.22|样 50.87|的 51.52|爱"
          },
          {
            "time": 52.17,
            "zh": "让音符飞向那云海",
            "en": "Let the notes fly into the sea of clouds",
            "chars": "52.17|让 52.83|音 53.48|符 54.13|飞 54.78|向 55.43|那 56.09|云 56.74|海"
          },
          {
            "time": 57.39,
            "zh": "我们与世界同频",
